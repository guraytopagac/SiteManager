{
  "name": "mavikent-site-yonetimi",
  "private": true,
  "version": "2.2.0",
  "description": "Mavikent Site Yönetimi Uygulaması",
  "author": "Güray Topağaç",
  "type": "commonjs",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently --kill-others -n vite,electron \"vite\" \"npm run electron:dev\"",
    "electron:dev": "wait-on http://localhost:5173 && electron .",
    "build": "vite build",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "start": "electron .",
    "reset-appdata": "node -e \"require('fs').rmSync(require('path').join(process.env.APPDATA,'mavikent-site-yonetimi'),{recursive:true,force:true})\"",
    "reset-db": "node -e \"['database.db','database.db-wal','database.db-shm'].forEach(f=>require('fs').rmSync(f,{force:true}))\"",
    "dist": "vite build && electron-builder --publish never",
    "rebuild": "electron-builder install-app-deps",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.mavikent.sitemanager",
    "productName": "Mavikent Site Yönetimi",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "database/*.js",
      "database/schema/**/*",
      "database/migrations/**/*",
      "assets/**/*",
      "!assets/backgrounds/auth/**",
      "!assets/backgrounds/setup/**"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "artifactName": "Mavikent-Site-Yonetimi-Setup-${version}.${ext}",
    "win": {
      "target": "nsis",
      "icon": "assets/app-icon.ico"
    },
    "nsis": {
      "perMachine": false,
      "oneClick": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mavikent Site Yönetimi",
      "deleteAppDataOnUninstall": true
    },
    "publish": {
      "provider": "github",
      "owner": "guraytopagac",
      "repo": "SiteManager"
    }
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.10.0",
    "electron-log": "^5.4.4",
    "electron-serve": "^3.0.1",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.1.2",
    "electron": "^41.0.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "exceljs": "^4.4.0",
    "globals": "^17.6.0",
    "prettier": "3.8.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-icons": "^5.6.0",
    "react-router-dom": "^7.15.1",
    "vite": "^8.0.12",
    "wait-on": "^8.0.3"
  }
}
